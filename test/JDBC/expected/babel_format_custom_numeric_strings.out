
-- Custom numeric format strings of FORMAT(). Every result was compared with
-- SQL Server 2022.
SELECT '[' + FORMAT(CAST(1 AS int), N'0') + ']'
GO
~~START~~
nvarchar
[1]
~~END~~


SELECT '[' + FORMAT(CAST(1 AS int), N'00') + ']'
GO
~~START~~
nvarchar
[01]
~~END~~


