~~END~~


-- the table resolves to dbo, the trigger is in another schema
CREATE TRIGGER babel_create_trigger_unq_s1.babel_create_trigger_unq_tr3 ON babel_create_trigger_unq_t1 AFTER DELETE AS
BEGIN
    SELECT 'tr3 fired'
END
GO
