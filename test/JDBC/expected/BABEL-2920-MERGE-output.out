~~END~~


-- the rolled back MERGE leaves no OUTPUT INTO rows in a permanent table
BEGIN TRANSACTION
go

MERGE INTO babel_2920_out_t AS t USING (SELECT 8 AS id) AS s ON t.id = s.id
WHEN NOT MATCHED THEN INSERT (id, val, qty) VALUES (s.id, 'eight', 8)
OUTPUT inserted.id, $action INTO babel_2920_out_log (id, act);
go
~~ROW COUNT: 1~~


ROLLBACK
go

SELECT COUNT(*) FROM babel_2920_out_log WHERE id = 8
go
~~START~~
int
0
~~END~~


-- error: OUTPUT to the client is not allowed in a function
CREATE FUNCTION babel_2920_out_f() RETURNS INT AS
BEGIN
    DECLARE @tv TABLE (id INT)
    MERGE INTO @tv AS t USING (SELECT 1 AS id) AS s ON t.id = s.id
    WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id)
    OUTPUT inserted.id;
    RETURN 1
END
go
~~ERROR (Code: 33557097)~~

~~ERROR (Message: Invalid use of a side-effecting operator 'MERGE' within a function.)~~


-- error: two OUTPUT clauses
MERGE INTO babel_2920_out_t AS t USING (SELECT 1 AS id) AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET qty = qty
OUTPUT inserted.id INTO babel_2920_out_log (id)
OUTPUT inserted.id;
go
~~ERROR (Code: 33557097)~~

~~ERROR (Message: 'MERGE with multiple OUTPUT clauses' is not currently supported in Babelfish)~~


-- error: common table expression together with OUTPUT INTO
WITH c AS (SELECT 1 AS id)
MERGE INTO babel_2920_out_t AS t USING c AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET qty = qty
OUTPUT inserted.id INTO babel_2920_out_log (id);
go
~~ERROR (Code: 33557097)~~

~~ERROR (Message: 'MERGE with a common table expression and OUTPUT ... INTO' is not currently supported in Babelfish)~~


-- a common table expression with OUTPUT to the client works
WITH c AS (SELECT 1 AS id)
MERGE INTO babel_2920_out_t AS t USING c AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET qty = 11
OUTPUT $action, inserted.id, inserted.qty;
go
~~START~~
nvarchar#!#int#!#int
~~END~~


